# Prizma — configuration template.
#
# Copy to `backend/.env` and fill in what you need. `.env` is gitignored;
# this file is not, so it must never contain a real value.
#
# Everything here is optional. With no .env at all the app runs exactly as it
# always has: SQLite on disk, loopback only, no email, no OAuth.

# ---------------------------------------------------------------- local only

# Contact URI put in the User-Agent of the keyless Wikipedia searcher.
# Without it every Wikimedia endpoint answers 403 and the keyless search floor
# is arXiv only. A repo or project URL is enough.
# CONTACT_URL=https://github.com/<user>/<repo>

# Where the SQLite file lives. Ignored the moment DATABASE_URL is set.
# Relative paths resolve against the process working directory, so an absolute
# one is safer — the app is started both from `backend/` and from the launcher.
# DB_PATH=C:/Users/you/Prizma/app.db

# Origins the browser may call the API from. Only matters when the frontend
# runs on its own port — `npm run dev` on 5173 is exactly that case, and both
# of its spellings are already the default. The built app is served by the
# backend itself, from the same origin, and needs nothing here.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Lets other devices on the same Wi-Fi open the app — used by
# `mobile/lan-preview.ps1` to try it on a phone. Off by default and refused
# together with PUBLIC_MODE: on a public host it would only widen the target.
# What still guards it is the access code and its throttle, so switch it on
# for the time you are looking and off afterwards.
# LAN_PREVIEW=1

# ------------------------------------------------------------- server deploy
# Set these on Render. Do not set them locally unless you are reproducing the
# deployment: PUBLIC_MODE=1 turns off the loopback check that protects a laptop.

# PUBLIC_MODE=1
# ALLOWED_HOSTS=["prizma.onrender.com"]
# PUBLIC_BASE_URL=https://prizma.onrender.com
# FRONTEND_URL=https://prizma.onrender.com

# Neon. The `+psycopg` driver and `sslmode=require` are both mandatory.
# DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.eu-central-1.aws.neon.tech/prizma?sslmode=require

# Master key for encrypting provider API keys at rest.
# Generate with:  python scripts/gen_secret.py
# SECRET_KEY=

# Only this address may claim the single account. Leave unset locally; set it
# before the URL is public, or the first stranger to find it owns the app.
# OWNER_EMAIL=you@example.com

# Turn the 4-digit access code off once Google/GitHub/email login is linked.
# PASSCODE_LOGIN_ENABLED=0

# ------------------------------------------------------------------- sign-in
# Redirect URI to register with every provider below:
#   https://<your-host>/api/auth/oauth/<provider>/callback

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Apple needs a paid Apple Developer membership and a verified domain; its
# secret is an ES256 JWT, not a static string. Left unset = button shows as
# "nenastaveno", which is the correct behaviour until both exist.
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# ---------------------------------------------------------------------- mail
# Resend. Without a verified domain it sends only to the account's own signup
# address — which is the only recipient this app has.
# RESEND_API_KEY=
# MAIL_FROM=Prizma <onboarding@resend.dev>

# ----------------------------------------------------------- provider keys
# Optional escape hatch: any provider key can live in the environment instead
# of the database, and the environment always wins. The name is PRIZMA_KEY_
# plus the credential id in upper case.
# PRIZMA_KEY_GROQ=
# PRIZMA_KEY_OPENROUTER=
